+import protobuf from 'protobufjs/light.js';
+import { jidNormalizedUser } from '../WABinary/jid-utils.js';
+
+export const wasaCollection = 'regular_high';
+export const wasaIndex = 'wasa_root_secret';
+const botAddress = /^\d+@bot$/;
+
+// Decode-only projection of waSyncAction at whatsmeow 8b41cfe6d9. Keep field 89
+// out of the public WAProto action/event objects and the outbound patch encoder.
+const actionData = protobuf.Root.fromJSON({ nested: {
+    ActionData: { fields: { value: { type: 'ActionValue', id: 2 } } },
+    ActionValue: { fields: { roots: { type: 'Roots', id: 89 } } },
+    Roots: { fields: { entries: { rule: 'repeated', type: 'Entry', id: 1 } } },
+    Entry: { fields: {
+        id: { type: 'string', id: 1 }, secret: { type: 'bytes', id: 2 },
+        epoch: { type: 'int64', id: 3 }, status: { type: 'int32', id: 4 }
+    } }
+} }).lookupType('ActionData');
+
+// No downgrade to an older entry if the latest ACTIVE entry is incomplete.
+export const decodeActiveWasaRoot = (bytes) => {
+    const entries = actionData.decode(bytes).value?.roots?.entries ?? [];
+    let latest;
+    let tied = false;
+    for (const entry of entries) {
+        if (entry.status !== 1) continue;
+        const epoch = BigInt(entry.epoch.toString());
+        if (!latest || epoch > latest.epoch) {
+            latest = { epoch, entry };
+            tied = false;
+        } else if (epoch === latest.epoch) {
+            tied = true;
+        }
+    }
+    const selected = latest?.entry;
+    if (!tied && selected?.id && selected.secret.length === 32) {
+        return { id: selected.id, secret: Buffer.from(selected.secret) };
+    }
+};
+
+export const isWasaBot = (jid) => typeof jid === 'string' && botAddress.test(jid);
+export const wasaOwner = (creds) => {
+    const lid = creds.me?.lid;
+    if (typeof lid === 'string' && /^\d+(?::\d+)?@lid$/.test(lid)) return jidNormalizedUser(lid);
+};
+
+export const getWasaRoot = async ({ creds, keys }, bot) => {
+    const owner = wasaOwner(creds);
+    if (!owner || !isWasaBot(bot)) return;
+    const { [wasaCollection]: state } = await keys.get('app-state-sync-version', [wasaCollection]);
+    if (state?.wasaOwner !== owner || state.wasaPending) return;
+    const root = state.wasaRoots?.[bot];
+    if (typeof root?.id === 'string' && root.id && root.secret instanceof Uint8Array && root.secret.length === 32) {
+        return { id: root.id, secret: Buffer.from(root.secret) };
+    }
+};
