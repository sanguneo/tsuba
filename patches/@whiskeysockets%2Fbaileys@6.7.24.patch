@@ -0,0 +1,17 @@
+import { proto } from '../../WAProto/index.js';
+import { aesEncryptGCM, hkdf } from './crypto.js';
+
+// whatsmeow 19d61352, msgsecret.go: encryptWASAMessage. The inner Message has
+// no Signal padding. Only the bot participant gets this envelope, never our DSM.
+export async function wrapMuse(prompt, key, { lid, root, encIv }) {
+    const botSecret = await hkdf(root.secret, 32, { info: 'Bot Message' });
+    const cipherKey = await hkdf(botSecret, 32, { info: `${key.id}${lid}${key.remoteJid}` });
+    const ctx = prompt.messageContextInfo;
+    const bytes = proto.Message.encode({ ...prompt, messageContextInfo: {
+        ...ctx, botMetadata: { ...ctx.botMetadata, capabilityMetadata: {} }
+    } }).finish();
+    return { secretEncryptedMessage: {
+        targetMessageKey: { ...key, id: root.id },
+        encIv, encPayload: aesEncryptGCM(bytes, cipherKey, encIv, Buffer.from(`${key.id}\0${lid}`))
+    } };
+}
