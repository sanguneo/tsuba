+import { proto } from '../../WAProto/index.js';
+import { aesDecryptGCM, hkdf } from './crypto.js';
+import { unpadRandomMax16 } from './generics.js';
+
+// Unlike areJidsSameUser, this comparison keeps the PN and LID namespaces separate.
+const identity = /^(\d+)(?::\d+)?@(s\.whatsapp\.net|lid)$/;
+function ownAddress(jid, me) {
+    const parsed = identity.exec(jid);
+    if (!parsed) return;
+    const self = identity.exec(parsed[2] === 'lid' ? me.lid : me.id);
+    if (self && self[1] === parsed[1] && self[2] === parsed[2]) {
+        return `${parsed[1]}@${parsed[2]}`;
+    }
+}
+
+export const hasBotAddress = ({ attrs }) => [attrs.from, attrs.recipient].some(jid => jid?.endsWith('@bot'));
+export const hasBotCiphertext = stanza => Array.isArray(stanza.content) &&
+    stanza.content.some(child => child.tag === 'enc' && child.attrs.type === 'msmsg');
+export function directBotAddress(stanza, me) {
+    const { from, recipient, participant, id } = stanza.attrs;
+    if (stanza.tag !== 'message' || !id || participant !== undefined ||
+        stanza.attrs.target_chat_jid !== undefined ||
+        (Array.isArray(stanza.content) && stanza.content.some(child => child.attrs.target_chat_jid !== undefined))) return;
+    if (recipient === undefined && /^\d+@bot$/.test(from)) return from;
+    if (/^\d+@bot$/.test(recipient) && ownAddress(from, me)) return recipient;
+}
+
+// One outcome per stanza: never merge an unchecked plaintext/second envelope into a reply.
+export async function receiveDirectBot(stanza, me, { repository, hooks }) {
+    const children = Array.isArray(stanza.content) ? stanza.content : [];
+    const envelopes = children.filter(child => ['enc', 'plaintext', 'unavailable'].includes(child.tag));
+    const enc = envelopes[0];
+    if (envelopes.length !== 1 || enc.tag !== 'enc' || !(enc.content instanceof Uint8Array) ||
+        (enc.attrs.v !== undefined && enc.attrs.v !== '2')) return 'unsupported-envelope';
+    const { from, recipient, id } = stanza.attrs;
+    if (recipient !== undefined) {
+        if (!['msg', 'pkmsg'].includes(enc.attrs.type)) return 'unsupported-envelope';
+        try {
+            const bytes = await repository.decryptMessage({ jid: from, type: enc.attrs.type, ciphertext: enc.content });
+            const copy = proto.Message.decode(unpadRandomMax16(bytes)).deviceSentMessage;
+            return copy?.destinationJid === recipient && copy.message ? copy.message : 'invalid-target';
+        } catch {
+            return 'invalid-payload';
+        }
+    }
+    if (enc.attrs.type !== 'msmsg') return 'unsupported-envelope';
+    const metas = children.filter(child => child.tag === 'meta');
+    const edits = children.filter(child => child.tag === 'bot');
+    if (metas.length !== 1 || edits.length > 1) return 'invalid-target';
+    const { target_id, target_sender_jid } = metas[0].attrs;
+    const sender = ownAddress(target_sender_jid ?? me.lid, me);
+    if (!target_id || !sender) return 'invalid-target';
+    const { edit, edit_target_id } = edits[0]?.attrs ?? {};
+    if (edit !== undefined && !['first', 'inner', 'last', 'full'].includes(edit)) return 'unsupported-envelope';
+    let envelope;
+    try {
+        envelope = proto.MessageSecretMessage.decode(enc.content);
+    } catch {
+        return 'invalid-payload';
+    }
+    if (envelope.version != null && envelope.version !== 0) return 'unsupported-envelope';
+    const { encIv, encPayload } = envelope;
+    if (encIv?.length !== 12 || !encPayload || encPayload.length <= 16) return 'invalid-payload';
+    let prompt;
+    try {
+        prompt = await hooks?.getMessage?.({ remoteJid: from, fromMe: true, id: target_id });
+    } catch {
+        return 'lookup-failed';
+    }
+    const secret = prompt?.messageContextInfo?.messageSecret;
+    if (!(secret instanceof Uint8Array) || secret.length !== 32) return 'missing-secret';
+    const botSecret = await hkdf(secret, 32, { info: 'Bot Message' });
+    const ids = ['inner', 'last'].includes(edit) && edit_target_id && edit_target_id !== id ? [edit_target_id, id] : [id];
+    for (const candidate of ids) {
+        const key = await hkdf(botSecret, 32, { info: `${candidate}${sender}${from}` });
+        let plaintext;
+        try {
+            plaintext = aesDecryptGCM(encPayload, key, encIv, Buffer.from(`${candidate}\0${from}`));
+        } catch {
+            continue;
+        }
+        try {
+            const message = proto.Message.decode(plaintext);
+            if (!Object.keys(message).length || message.deviceSentMessage || message.secretEncryptedMessage ||
+                message.protocolMessage || message.senderKeyDistributionMessage) return 'unsupported-envelope';
+            return message;
+        } catch {
+            return 'invalid-payload';
+        }
+    }
+    return 'authentication-failed';
+}
