+import { randomBytes } from 'crypto';
+import { Boom } from '@hapi/boom';
+import { proto } from '../../WAProto/index.js';
+import { wrapMuse } from '../Utils/wasa-envelope.js';
+import { encodeSignedDeviceIdentity, generateMessageIDV2, unixTimestampSeconds } from '../Utils/index.js';
+import { getWasaRoot } from '../Utils/wasa-state.js';
+import { jidDecode, jidEncode } from '../WABinary/index.js';
+
+const META_AI = '867051314767696@bot';
+const MUSE = '1807055946647697@bot';
+const ACK = 'CB:ack,class:message';
+
+export class DirectBotSendUnavailableError extends Error {
+    constructor() {
+        super('Direct bot text is unavailable');
+        this.name = 'DirectBotSendUnavailableError';
+    }
+}
+
+async function route(authState, jid) {
+    const me = authState.creds.me;
+    if (!/^\d+(?::\d+)?@s\.whatsapp\.net$/.test(me?.id) || !/^\d+(?::\d+)?@lid$/.test(me?.lid)) return;
+    const lid = jidEncode(jidDecode(me.lid).user, 'lid');
+    if (jid === META_AI) return { lid, personaId: '867051314767696$760019659443059' };
+    if (jid === MUSE) {
+        const root = await getWasaRoot(authState, jid);
+        if (root) return { lid, personaId: '1807055946647697$1', root };
+    }
+}
+
+async function sendAndConfirm(sock, stanza, timeoutMs) {
+    let onAck, onClose, timer;
+    const ack = new Promise((resolve, reject) => {
+        onAck = ({ attrs }) => {
+            if (attrs.id !== stanza.attrs.id) return;
+            if (attrs.error !== undefined) reject(new Boom('WhatsApp returned an error acknowledgement', {
+                statusCode: ['401', '403', '404', '429'].includes(attrs.error) ? Number(attrs.error) : 500
+            }));
+            else resolve();
+        };
+        onClose = () => reject(new Boom('Connection closed before acknowledgement'));
+        timer = setTimeout(() => reject(new Boom('WhatsApp acknowledgement timed out')), timeoutMs);
+        sock.ws.on(ACK, onAck);
+        sock.ws.on('close', onClose);
+    });
+    try {
+        await Promise.all([ack, sock.sendNode(stanza)]);
+    } finally {
+        clearTimeout(timer);
+        sock.ws.off(ACK, onAck);
+        sock.ws.off('close', onClose);
+    }
+}
+
+export function directBotSender(sock, relay, timeoutMs) {
