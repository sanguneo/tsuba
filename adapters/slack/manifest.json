{
  "display_information": {
    "name": "tsuba",
    "description": "Reads and writes your Slack as you, for your own messenger client (tsuba/saya)."
  },
  "features": {},
  "oauth_config": {
    "scopes": {
      "user": [
        "channels:read",
        "groups:read",
        "im:read",
        "mpim:read",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "channels:write",
        "groups:write",
        "im:write",
        "mpim:write",
        "chat:write",
        "reactions:read",
        "reactions:write",
        "files:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "user_events": [
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "reaction_added",
        "reaction_removed"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
