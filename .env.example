# Copy to .env (ignored by git). Bun loads it from the repository root.

# From https://my.telegram.org/apps, for the account the adapter acts as.
TSUBA_TELEGRAM_API_ID=
TSUBA_TELEGRAM_API_HASH=

# Optional: where the network blocks Telegram, reach it through a proxy.
# socks5://host:port, http://host:port, or a tg://proxy MTProxy link.
TSUBA_TELEGRAM_PROXY=

# Optional: a Discord bot account (Developer Portal > Bot > Reset Token).
# The bot must have Message Content Intent enabled.
TSUBA_DISCORD_TOKEN=

# Optional: its own HTTP token and port; otherwise TSUBA_TOKEN and 8792.
TSUBA_DISCORD_HTTP_TOKEN=
TSUBA_DISCORD_PORT=

# Optional: a separate personal Discord account adapter; see docs/discord-user.md.
TSUBA_DISCORD_USER_TOKEN=
# Optional: its own HTTP token and port; otherwise TSUBA_TOKEN and 8794.
TSUBA_DISCORD_USER_HTTP_TOKEN=
TSUBA_DISCORD_USER_PORT=

# Slack: from your own app (adapters/slack/manifest.json, see docs/slack.md).
# User OAuth Token (xoxp-) and an app-level token with connections:write (xapp-).
TSUBA_SLACK_USER_TOKEN=
TSUBA_SLACK_APP_TOKEN=
# Optional: its own HTTP token and port; otherwise TSUBA_TOKEN and 8793.
TSUBA_SLACK_HTTP_TOKEN=
TSUBA_SLACK_PORT=

# iMessage: no credential of its own — it reads the Mac's own Messages account
# through `imsg`, which needs Full Disk Access (see docs/imessage.md).
# Optional: where `imsg` lives; otherwise /opt/homebrew/bin/imsg.
TSUBA_IMESSAGE_BIN=
# Optional: its own HTTP token and port; otherwise TSUBA_TOKEN and 8795.
TSUBA_IMESSAGE_HTTP_TOKEN=
TSUBA_IMESSAGE_PORT=
