# Copy to .env (ignored by git). Bun loads it from the repository root.

# From https://my.telegram.org/apps, for the account the adapter acts as.
TSUBA_TELEGRAM_API_ID=
TSUBA_TELEGRAM_API_HASH=

# Optional: where the network blocks Telegram, reach it through a proxy.
# socks5://host:port, http://host:port, or a tg://proxy MTProxy link.
TSUBA_TELEGRAM_PROXY=
